# Required for real AI chat (Claude Haiku 5.5). The app runs without it:
# chat returns 503, or set LLM_MOCK=true for deterministic mock replies.
ANTHROPIC_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# If not set, the built-in market simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Optional: Massive poll interval in seconds (default 15, suits the free tier;
# paid tiers can use 2-15). Ignored when using the simulator.
MASSIVE_POLL_INTERVAL=

# Optional: set to "true" for deterministic mock LLM responses (testing).
LLM_MOCK=false

# Optional: SQLite file location. Defaults to <project root>/db/finally.db locally;
# the Docker image sets it to /app/db/finally.db. Leave commented out when using
# Docker: an empty DB_PATH= in --env-file would override the image's value.
# DB_PATH=
